# PostgreSQL container on the Oracle VM
POSTGRES_DB=jobfetcher
POSTGRES_USER=jobfetcher
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=jdbc:postgresql://postgres:5432/jobfetcher
DATABASE_USERNAME=jobfetcher
DATABASE_PASSWORD=replace-with-a-long-random-password

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Browser and backend origins
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Resume storage
RESUME_STORAGE_DIR=./data/resumes
RESUME_STORAGE_DIR_HOST=./data/resumes

# Container registry
GHCR_OWNER=honey0632
IMAGE_TAG=latest

# Matching provider: keyword (default) or gemini
MATCHING_PROVIDER=keyword
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
