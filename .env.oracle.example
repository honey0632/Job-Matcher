# Oracle VM PostgreSQL container
POSTGRES_DB=jobfetcher
POSTGRES_USER=jobfetcher
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=jdbc:postgresql://postgres:5432/jobfetcher
DATABASE_USERNAME=jobfetcher
DATABASE_PASSWORD=replace-with-a-long-random-password

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public domains
FRONTEND_ORIGIN=https://jobmatcher.in
VITE_API_BASE_URL=https://api.jobmatcher.in

# Persistent resume storage
RESUME_STORAGE_DIR=/app/data/resumes
RESUME_STORAGE_DIR_HOST=/opt/jobmatcher/data/resumes

# Published image
GHCR_OWNER=honey0632
IMAGE_TAG=latest
